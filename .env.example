# =====================================================================
# Environment variables for the "prod" profile (application-prod.properties).
# Spring Boot does NOT read this file by itself: set these variables in your
# shell, IDE run configuration or deployment platform.
# Never commit real values.
# =====================================================================

SPRING_PROFILES_ACTIVE=prod

# ---------- Database ----------
DB_URL=jdbc:postgresql://localhost:5432/coretrust
DB_USERNAME=
DB_PASSWORD=
# Optional (default 20)
DB_POOL_SIZE=

# ---------- JWT: at least 32 random bytes, Base64-encoded ----------
JWT_SECRET=

# ---------- Bootstrap admin (created on first start if missing) ----------
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# ---------- Mail ----------
MAIL_HOST=
MAIL_PORT=
# Optional
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=
# Optional (default 6379)
REDIS_PORT=
# Optional
REDIS_PASSWORD=

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------- Links in emails ----------
FRONTEND_SET_PASSWORD_URL=https://app.example.com/set-password
FRONTEND_RESET_PASSWORD_URL=https://app.example.com/reset-password

# ---------- CORS: comma-separated browser origins ----------
CORS_ALLOWED_ORIGINS=https://app.example.com

# ---------- Optional ----------
# SERVER_PORT=8080
